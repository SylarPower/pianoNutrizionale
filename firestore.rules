rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App Check NON sostituisce Authentication e Firestore Rules: viene
    // valutato a parte. Qui ogni accesso richiede comunque un utente
    // autenticato con l'UID corretto o membro della household richiesta.

    function signedIn() {
      return request.auth != null;
    }

    function householdMember(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId))
        && get(/databases/$(database)/documents/households/$(householdId))
          .data.memberUids.hasAny([request.auth.uid]);
    }

    function householdMemberAfter(householdId) {
      return signedIn()
        && getAfter(/databases/$(database)/documents/households/$(householdId))
          .data.memberUids.hasAny([request.auth.uid]);
    }

    // Directory minima username → uid, necessaria per cercare il destinatario.
    // L'email tecnica del token impedisce di registrare lo username di un altro
    // account e un account diverso non può sovrascrivere una voce esistente.
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && request.auth.token.email == username + '@utenti.pianonutrizionale.app';
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && request.auth.token.email == username + '@utenti.pianonutrizionale.app';
      allow delete: if false;
    }

    // Richieste di ricette e di collegamento account. Entrambe sono visibili
    // solo a mittente e destinatario e possono essere eliminate solo da chi le
    // riceve. Il payload accountLink contiene la base del mittente necessaria
    // a creare la prima household senza aprire i suoi documenti personali.
    match /recipeShares/{shareId} {
      function commonPendingRequest() {
        return signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.recipientUid != request.auth.uid
          && request.resource.data.recipientUid is string
          && request.resource.data.recipientUid.size() > 0
          && request.resource.data.senderUsername is string
          && request.resource.data.recipientUsername is string
          && request.resource.data.status == 'pending'
          && request.resource.data.recipes is list
          && request.resource.data.recipeCount is int;
      }

      function validRecipeShare() {
        return (!('type' in request.resource.data) || request.resource.data.type == 'recipe')
          && request.resource.data.recipeCount > 0
          && (request.resource.data.includesPlan == true
            ? request.resource.data.plan != null
            : request.resource.data.plan == null || request.resource.data.includesPlan == false);
      }

      function validAccountLink() {
        return request.resource.data.type == 'accountLink'
          && request.resource.data.recipeCount >= 0
          && request.resource.data.includesPlan == true
          && request.resource.data.plan is map
          && request.resource.data.shoppingList is map
          && request.resource.data.sourceMemberUids is list
          && request.resource.data.sourceMemberUids.hasAny([request.auth.uid])
          && request.resource.data.sourceMemberUsernames is list
          && (request.resource.data.sourceHouseholdId == null
            || request.resource.data.sourceHouseholdId is string);
      }

      function shareIsPending() {
        return resource.data.status == 'pending';
      }

      allow create: if commonPendingRequest()
        && (validRecipeShare() || validAccountLink());
      allow read: if signedIn()
        && (resource.data.senderUid == request.auth.uid
          || resource.data.recipientUid == request.auth.uid);
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && shareIsPending()
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'respondedAt']);
      allow delete: if signedIn() && resource.data.recipientUid == request.auth.uid;
    }

    // Metadati della household. La creazione è vincolata a un invito pending;
    // un destinatario può aggiungere soltanto se stesso al gruppo indicato
    // dall'invito. Ogni membro può rimuovere soltanto il proprio UID.
    match /households/{householdId} {
      function linkForCreate() {
        let linkId = request.resource.data.createdFromLinkRequest;
        let linkPath = /databases/$(database)/documents/recipeShares/$(linkId);
        return linkId is string
          && exists(linkPath)
          && householdId == linkId
          && get(linkPath).data.type == 'accountLink'
          && get(linkPath).data.status == 'pending'
          && get(linkPath).data.sourceHouseholdId == null
          && get(linkPath).data.recipientUid == request.auth.uid
          && request.resource.data.ownerUid == get(linkPath).data.senderUid
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.size() == 2
          && request.resource.data.memberUids.hasAll([get(linkPath).data.senderUid, request.auth.uid])
          && request.resource.data.memberUsernames is list
          && request.resource.data.memberUsernames.size() == 2
          && request.resource.data.memberUsernames.hasAll([
            get(linkPath).data.senderUsername,
            get(linkPath).data.recipientUsername
          ]);
      }

      function joiningFromLink() {
        let linkId = request.resource.data.lastLinkRequestId;
        let linkPath = /databases/$(database)/documents/recipeShares/$(linkId);
        return linkId is string
          && exists(linkPath)
          && get(linkPath).data.type == 'accountLink'
          && get(linkPath).data.status == 'pending'
          && get(linkPath).data.recipientUid == request.auth.uid
          && get(linkPath).data.sourceHouseholdId == householdId
          && resource.data.memberUids.hasAny([get(linkPath).data.senderUid])
          && !resource.data.memberUids.hasAny([request.auth.uid])
          && request.resource.data.memberUids.hasAny([request.auth.uid])
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUsernames.size() == resource.data.memberUsernames.size() + 1
          && request.resource.data.memberUsernames.hasAll(resource.data.memberUsernames)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberUids', 'memberUsernames', 'lastLinkRequestId', 'updatedAt']);
      }

      function leavingSelf() {
        return resource.data.memberUids.hasAny([request.auth.uid])
          && !request.resource.data.memberUids.hasAny([request.auth.uid])
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && request.resource.data.memberUsernames.size() == resource.data.memberUsernames.size() - 1
          && resource.data.memberUsernames.hasAll(request.resource.data.memberUsernames)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberUids', 'memberUsernames', 'updatedAt']);
      }

      allow create: if signedIn() && linkForCreate();
      allow read: if signedIn() && resource.data.memberUids.hasAny([request.auth.uid]);
      allow update: if signedIn() && (joiningFromLink() || leavingSelf());
      allow delete: if false;
    }

    // Catalogo, piano (batchTemplates compresi) e lista spesa condivisi.
    // getAfter consente al destinatario di creare/sostituire i documenti nello
    // stesso batch atomico in cui entra nella household.
    match /households/{householdId}/{document=**} {
      allow read: if householdMember(householdId);
      allow write: if householdMember(householdId) || householdMemberAfter(householdId);
    }

    // Area privata: dati indipendenti e backup personali.
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Backup precedente (users/{uid}/backups/previous): una sola copia per
    // utente, ripristinabile una sola volta dall'app (transazione atomica).
    match /users/{userId}/backups/{backupId} {
      allow read, write, delete: if signedIn() && request.auth.uid == userId;
    }

    // ----- Piano SaaS multi-tenant -----
    // Le membership sono la fonte autorevole; i custom claims non bastano.
    // Tutte le mutazioni SaaS passano da Cloud Functions/Admin SDK. Il client
    // può leggere direttamente soltanto la propria membership e i clienti che
    // il tenant gli ha assegnato. Profilo attivo, regole e coda mapping vengono
    // restituiti da callable per impedire IDOR e selezione autonoma del ruleSet.
    function activeTenantMember(organizationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role in ['admin', 'nutritionist'];
    }

    function tenantAdmin(organizationId) {
      return activeTenantMember(organizationId)
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    function authorizedNutritionist(organizationId, clientId) {
      return activeTenantMember(organizationId)
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role == 'nutritionist'
        && get(/databases/$(database)/documents/organizations/$(organizationId)/clients/$(clientId)).data.nutritionistUids.hasAny([request.auth.uid]);
    }

    match /platformMembers/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /accountClientLinks/{userId} {
      allow read, write: if false;
    }

    match /globalRuleSets/{ruleSetId}/{document=**} {
      allow read, write: if false;
    }

    match /globalMappings/{mappingId}/{document=**} {
      allow read, write: if false;
    }

    // Catalogo globale ingredienti (autocomplete editor/console): lettura
    // della versione corrente consentita agli utenti autenticati, scritture
    // solo da callable/Admin SDK. Configurazione (denylist, flag import) e
    // snapshot versionati sono server-only: nessun accesso diretto.
    match /globalIngredientCatalog/current/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /globalIngredientCatalog/config/{document=**} {
      allow read, write: if false;
    }

    match /globalIngredientCatalog/versions/{document=**} {
      allow read, write: if false;
    }

    match /organizations/{organizationId} {
      allow read: if activeTenantMember(organizationId);
      allow write: if false;
    }

    match /organizations/{organizationId}/members/{userId} {
      allow read: if activeTenantMember(organizationId) && (request.auth.uid == userId || tenantAdmin(organizationId));
      allow write: if false;
    }

    match /organizations/{organizationId}/clients/{clientId} {
      allow read: if tenantAdmin(organizationId) || authorizedNutritionist(organizationId, clientId);
      allow write: if false;
    }

    match /organizations/{organizationId}/clients/{clientId}/{document=**} {
      allow read: if tenantAdmin(organizationId) || authorizedNutritionist(organizationId, clientId);
      allow write: if false;
    }

    // Strutture dieta e revisioni: NESSUN accesso diretto (privacy ownerUid
    // applicata dalle callable listDietStructures/authorizedStructure).
    // Esplicito per documentare l'intento oltre al catch-all.
    match /organizations/{organizationId}/dietStructures/{structureId} {
      allow read, write: if false;
    }

    match /organizations/{organizationId}/dietStructures/{structureId}/revisions/{revisionId} {
      allow read, write: if false;
    }

    // Inviti monouso: lettura ai contraenti (admin + chi ha creato l'invito).
    // Il token in chiaro non è mai nel documento (solo hash); riscatto via
    // callable con binding allo username invitato.
    match /organizations/{organizationId}/invitations/{inviteId} {
      allow read: if tenantAdmin(organizationId)
        || (activeTenantMember(organizationId) && resource.data.createdBy == request.auth.uid);
      allow write: if false;
    }

    // Richieste di collegamento: lettura ai contraenti (admin, professionista
    // proponente, cliente destinatario). Accettazione solo via callable.
    match /organizations/{organizationId}/clientLinkRequests/{requestId} {
      allow read: if tenantAdmin(organizationId)
        || (activeTenantMember(organizationId) && resource.data.nutritionistUid == request.auth.uid)
        || (signedIn() && resource.data.targetUid == request.auth.uid);
      allow write: if false;
    }

    // Code, cataloghi, notifiche e audit non sono interrogabili
    // direttamente: le callable filtrano campi personali e autorizzazioni.
    match /organizations/{organizationId}/{document=**} {
      allow read, write: if false;
    }

    // Prezzi condivisi (Spesa Smart): UNICO database per tutti gli utenti.
    // Ogni account autenticato legge tutto; la creazione è aperta ma
    // vincolata ai campi previsti e all'UID dell'autore; modifica ed
    // eliminazione restano riservate a chi ha registrato la voce.
    match /priceMeta/global {
      function validMeta() {
        return request.resource.data.stores is list
          && request.resource.data.products is list
          && request.resource.data.brands is list
          && request.resource.data.stores.size() <= 2000
          && request.resource.data.products.size() <= 4000
          && request.resource.data.brands.size() <= 2000;
      }
      allow read: if signedIn();
      allow create, update: if signedIn() && validMeta();
      allow delete: if false;
    }

    match /priceEntries/{entryId} {
      function validEntry() {
        return request.resource.data.store is string && request.resource.data.store.size() > 0
          && request.resource.data.product is string && request.resource.data.product.size() > 0
          && request.resource.data.brand is string
          && request.resource.data.storeKey is string
          && request.resource.data.productKey is string
          && request.resource.data.brandKey is string
          && request.resource.data.price is number && request.resource.data.price > 0
          && request.resource.data.weight is number && request.resource.data.weight > 0
          && request.resource.data.unit in ['gr', 'kg', 'ml', 'l', 'pz']
          && request.resource.data.normPrice is number && request.resource.data.normPrice > 0
          && request.resource.data.normUnit in ['kg', 'l', 'pz']
          && request.resource.data.date is string
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdByUsername is string;
      }

      allow read: if signedIn();
      allow create: if signedIn() && validEntry();
      allow update: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && validEntry();
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
